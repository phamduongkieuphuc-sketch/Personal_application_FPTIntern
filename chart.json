{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/editor/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "projection": {"type": "equalEarth"},
      "mark": {"type": "geoshape", "fill": "#eee", "stroke": "#999"}
    },
    {
      "data": {
        "values": [
          {"place": "Vietnam", "lat": 14.0583, "lon": 108.2772, "pop": 100000000},
          {"place": "Japan", "lat": 36.2048, "lon": 138.2529, "pop": 125000000}
        ]
      },
      "mark": {"type": "circle", "color": "green", "opacity": 0.6},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "pop",
          "type": "quantitative",
          "scale": {"range": [100, 3000]}
        },
        "tooltip": [{"field": "place", "type": "nominal"}]
      }
    }
  ]
}
