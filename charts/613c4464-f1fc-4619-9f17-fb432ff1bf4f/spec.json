{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "description": "T\u1ef7 l\u1ec7 doanh thu c\u00e1c s\u1ea3n ph\u1ea9m trong th\u00e1ng tr\u01b0\u1edbc",
    "data": {
        "name": "input_data"
    },
    "mark": "arc",
    "encoding": {
        "theta": {
            "field": "revenue",
            "type": "quantitative"
        },
        "color": {
            "field": "product_name",
            "type": "nominal",
            "legend": {
                "title": "T\u00ean S\u1ea3n Ph\u1ea9m"
            }
        }
    },
    "transform": [
        {
            "calculate": "datum.revenue",
            "as": "revenue"
        }
    ],
    "datasets": {
        "input_data": [
            {
                "product_name": "thit lon",
                "revenue": 10000000
            },
            {
                "product_name": "thit bo",
                "revenue": 7600000
            },
            {
                "product_name": "thit ga",
                "revenue": 2000000
            },
            {
                "product_name": "thit cuu",
                "revenue": 3000000
            },
            {
                "product_name": "thit kangaroo",
                "revenue": 1000000
            }
        ]
    }
}