{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Category vs Group with Values",
    "data": {
        "name": "input_data"
    },
    "layer": [
        {
            "mark": "bar",
            "encoding": {
                "x": {
